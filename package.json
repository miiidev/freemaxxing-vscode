{
  "name": "freemaxxing-vscode",
  "displayName": "FreeMaxxing",
  "description": "Local LLM proxy manager — start, stop, monitor your FreeMaxxing server from VS Code",
  "version": "0.1.0",
  "publisher": "miiidev",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/miiidev/freemaxxing-vscode"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "freemaxxing.menu",
        "title": "FreeMaxxing: Show Menu"
      },
      {
        "command": "freemaxxing.start",
        "title": "FreeMaxxing: Start Server"
      },
      {
        "command": "freemaxxing.stop",
        "title": "FreeMaxxing: Stop Server"
      },
      {
        "command": "freemaxxing.restart",
        "title": "FreeMaxxing: Restart Server"
      },
      {
        "command": "freemaxxing.status",
        "title": "FreeMaxxing: Show Status (Reliability)"
      },
      {
        "command": "freemaxxing.setup",
        "title": "FreeMaxxing: Run Setup Wizard"
      },
      {
        "command": "freemaxxing.trace",
        "title": "FreeMaxxing: Trace a Request"
      },
      {
        "command": "freemaxxing.revive",
        "title": "FreeMaxxing: Revive a Model or Provider"
      },
      {
        "command": "freemaxxing.openConfig",
        "title": "FreeMaxxing: Open Config File"
      },
      {
        "command": "freemaxxing.copyEndpoint",
        "title": "FreeMaxxing: Copy Endpoint Config"
      },
      {
        "command": "freemaxxing.exportStats",
        "title": "FreeMaxxing: Export Reliability Stats"
      },
      {
        "command": "freemaxxing.pointExtension",
        "title": "FreeMaxxing: Point Extension at FreeMaxxing"
      },
      {
        "command": "freemaxxing.showProviders",
        "title": "FreeMaxxing: Show Providers"
      },
      {
        "command": "freemaxxing.disableProvider",
        "title": "FreeMaxxing: Disable Provider"
      },
      {
        "command": "freemaxxing.enableProvider",
        "title": "FreeMaxxing: Enable Provider"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "freemaxxing",
          "title": "FreeMaxxing",
          "icon": "media/logo.svg"
        }
      ]
    },
    "views": {
      "freemaxxing": [
        {
          "type": "webview",
          "id": "freemaxxing.dashboard",
          "name": "Dashboard"
        }
      ]
    },
    "configuration": {
      "title": "FreeMaxxing",
      "properties": {
        "freemaxxing.cliPath": {
          "type": "string",
          "default": "freemaxxing",
          "description": "Path to the FreeMaxxing CLI binary. Override if not on PATH (e.g. \"node dist/cli.js\")."
        },
        "freemaxxing.host": {
          "type": "string",
          "default": "127.0.0.1",
          "description": "Host address the FreeMaxxing server binds to."
        },
        "freemaxxing.port": {
          "type": "number",
          "default": 8787,
          "description": "Port the FreeMaxxing server listens on."
        },
        "freemaxxing.autoStart": {
          "type": "boolean",
          "default": false,
          "description": "Automatically start the FreeMaxxing server when VS Code starts."
        },
        "freemaxxing.trace": {
          "type": "boolean",
          "default": true,
          "description": "Launch the server with the --trace flag to enable per-request routing logs."
        },
        "freemaxxing.defaultAlias": {
          "type": "string",
          "default": "auto/coding",
          "scope": "resource",
          "description": "Default model alias used when copying endpoint config. Workspace-scoped so different repos can use different aliases."
        },
        "freemaxxing.dashboardRefreshMs": {
          "type": "number",
          "default": 5000,
          "description": "Poll interval (ms) for the dashboard webview data refresh."
        },
        "freemaxxing.warnOnCooldown": {
          "type": "boolean",
          "default": true,
          "description": "Show a notification when a model in the default alias tier enters cooldown or exhaustion."
        },
        "freemaxxing.localBaseURL": {
          "type": "string",
          "default": "",
          "description": "Override base URL for the local provider (default: http://localhost:11434/v1)."
        },
        "freemaxxing.ttfbTimeoutMs": {
          "type": "number",
          "default": 30000,
          "description": "Time-to-first-byte timeout in milliseconds for upstream model requests."
        },
        "freemaxxing.retryBackoffMs": {
          "type": "number",
          "default": 1000,
          "description": "Backoff delay in milliseconds between retry attempts on rate-limited models."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --minify",
    "watch": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --watch",
    "lint": "tsc --noEmit",
    "compile:test": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "npm run compile && npm run compile:test && node out/test/runTests.js"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.0",
    "@types/node": "^20.10.0",
    "@types/vscode": "^1.85.0",
    "@vscode/test-electron": "^2.3.0",
    "esbuild": "^0.19.0",
    "typescript": "^5.9.3",
    "vitest": "^1.2.0"
  }
}
